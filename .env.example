# Kaggle API credentials
# Get from: https://www.kaggle.com/settings → API → Create New Token
KAGGLE_USERNAME=your_username_here
KAGGLE_KEY=your_api_key_here

# OpenCode Go API key for LLM label extraction (host-permitted)
# Get from: https://opencode.ai/auth → API Keys → Create Key
OPENCODE_API_KEY=sk-your_opencode_go_key_here
